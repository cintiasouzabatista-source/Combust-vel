:root { --bg:#0f172a; --card:#1e293b; --text:#f1f5f9; --muted:#94a3b8; --primary:#2563eb; --danger:#ef4444; --warn:#f59e0b; }
body.light { --bg:#f8fafc; --card:#fff; --text:#0f172a; --muted:#64748b; }
body { margin:0; background:var(--bg); color:var(--text); font-family:system-ui; }
header { padding:16px; background:var(--card); display:flex; justify-content:space-between; align-items:center; position:sticky; top:0; }
header h1 { font-size:18px; margin:0; }
header button { background:none; border:none; color:var(--text); font-size:20px; }
.tabs { display:flex; background:var(--card); padding:8px; gap:8px; position:sticky; top:60px; }
.tab-btn { flex:1; padding:12px; border:none; background:transparent; color:var(--muted); border-radius:8px; font-size:13px; }
.tab-btn.active { background:var(--primary); color:#fff; }
main { padding:16px; padding-bottom:80px; }
.aba { display:none; }
.aba.active { display:block; }
.card { background:var(--card); padding:16px; border-radius:12px; margin-bottom:12px; }
.kpi-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:16px; }
.card p { margin:0 0 4px 0; color:var(--muted); font-size:12px; }
.card h2 { margin:0; font-size:22px; }
input, select { width:100%; padding:12px; margin:8px 0; border:1px solid #334155; border-radius:8px; background:var(--bg); color:var(--text); box-sizing:border-box; font-size:16px; }
.grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
.grid-3 { display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px; }
.btn { width:100%; padding:14px; background:var(--primary); color:#fff; border:none; border-radius:8px; font-weight:bold; margin-top:8px; font-size:16px; }
.item { display:flex; justify-content:space-between; align-items:center; padding:12px; background:var(--card); border-radius:8px; margin:8px 0; }
.item.alerta { border-left:4px solid var(--warn); }
.item.vencida { border-left:4px solid var(--danger); }
.item-small { padding:8px 0; border-bottom:1px solid #334155; font-size:14px; }
.btn-del { background:var(--danger); color:#fff; border:none; padding:8px 12px; border-radius:6px; }
.muted { color:var(--muted); font-size:12px; margin:4px 0 0 0; }
.empty { text-align:center; color:var(--muted); padding:32px 0; }
